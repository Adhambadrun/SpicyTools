{
  "name": "@spicytools/widget",
  "version": "1.0.0",
  "description": "SpicyTools search widget — lightweight flight deal search form with spice-level fare heat",
  "main": "dist/spicytools.min.js",
  "style": "dist/spicytools.min.css",
  "types": "index.d.ts",
  "license": "MIT",
  "author": "SpicyTools",
  "homepage": "https://github.com/Adhambadrun/SpicyQuote#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adhambadrun/SpicyQuote.git"
  },
  "bugs": {
    "url": "https://github.com/Adhambadrun/SpicyQuote/issues"
  },
  "files": [
    "dist",
    "index.d.ts"
  ],
  "scripts": {
    "start": "cross-env NODE_ENV=development webpack serve --config webpack.dev.js",
    "build": "cross-env NODE_ENV=production webpack --config webpack.prod.js",
    "analyze": "cross-env NODE_ENV=production webpack --config webpack.analyzer.js",
    "test": "jest",
    "lint": "tslint -p ./tslint.json"
  },
  "dependencies": {
    "@types/classnames": "^2.2.3",
    "@types/js-cookie": "^2.1.0",
    "@types/moment": "^2.13.0",
    "@types/promise-polyfill": "^6.0.0",
    "@types/react": "^16.14.62",
    "@types/react-dom": "^16.9.24",
    "@types/react-onclickoutside": "^6.0.3",
    "@types/react-redux": "^5.0.28",
    "@types/redux-logger": "^3.0.13",
    "classnames": "^2.2.5",
    "custom-event-polyfill": "^1.0.6",
    "es5-shim": "^4.5.12",
    "es6-shim": "^0.35.3",
    "jest-fetch-mock": "^2.1.1",
    "js-cookie": "^2.1.4",
    "lvovich": "^1.0.13",
    "moment": "^2.30.1",
    "react-datepicker": "^2.8.0",
    "react-onclickoutside": "^6.7.1",
    "react-popper": "^1.3.11",
    "react-redux": "^5.0.7",
    "react-select": "^1.3.0",
    "redux-logger": "^3.0.6",
    "redux-saga": "^0.16.2",
    "redux-thunk": "2.2.0",
    "reselect": "^3.0.1",
    "whatwg-fetch": "^2.0.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^18.19.130",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mini-css-extract-plugin": "^2.9.2",
    "postcss": "^8.4.49",
    "postcss-loader": "^8.1.1",
    "react": "^16.4.2",
    "react-dom": "^16.4.2",
    "redux": "^4.0.5",
    "redux-testkit": "^1.0.6",
    "sass": "^1.83.0",
    "sass-loader": "^16.0.4",
    "terser-webpack-plugin": "^5.3.11",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "tslint": "^6.1.3",
    "typescript": "^4.9.5",
    "webpack": "^5.97.1",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.0",
    "webpack-merge": "^6.0.1"
  },
  "peerDependencies": {
    "react": "^16.4.x",
    "react-dom": "^16.4.x",
    "redux": "^4.x.x"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "setupFiles": [
      "./setupJest.ts"
    ],
    "modulePaths": [
      "<rootDir>/src"
    ],
    "moduleDirectories": [
      "node_modules",
      "src"
    ],
    "moduleFileExtensions": [
      "js",
      "ts",
      "tsx",
      "jsx",
      "json"
    ],
    "testMatch": [
      "**/__tests__/*.+(ts|tsx|js)"
    ],
    "moduleNameMapper": {
      "^@spicytools/react-datepicker$": [
        "<rootDir>/node_modules/react-datepicker",
        "<rootDir>/../../node_modules/react-datepicker"
      ],
      "^@spicytools/react-select$": [
        "<rootDir>/node_modules/react-select",
        "<rootDir>/../../node_modules/react-select"
      ]
    },
    "transform": {
      "^.+\\.(ts|tsx)$": [
        "ts-jest",
        {
          "diagnostics": {
            "warnOnly": true
          }
        }
      ]
    }
  },
  "browserslist": [
    ">0.5%",
    "last 2 versions",
    "not dead"
  ]
}
